# =============================================================================
#  server/.env.local  — PRODUCTION OVERRIDES (for IT)
#
#  Copy this file to  server/.env.local  and fill in the real values.
#  Loaded BEFORE .env, so anything set here WINS over the dev defaults in .env.
#  Only set what differs in production — leave the rest out to inherit .env.
#
#  NEVER commit .env.local (it holds secrets). Commit only THIS .example file.
# =============================================================================

# ---- Hosting -----------------------------------------------------------------
PORT=7001                                             # Node listen port (IIS/ARR proxies to this)
APP_URL=https://analytics.yourcompany.com            # public URL users hit (used post-login redirect)
TRUST_PROXY_HOPS=1                                    # number of reverse proxies in front (IIS/ARR = 1)
SERVE_STATIC=1                                        # serve the built ./dist SPA from this process

# ---- Session -----------------------------------------------------------------
# Optional. If unset, a random secret is generated on first run (server/data/.jwtsecret).
# Set it explicitly to keep sessions valid across redeploys / multiple instances.
JWT_SECRET=

# ---- Microsoft (Azure AD) sign-in -------------------------------------------
# The app users log in with. Redirect URI must EXACTLY match one registered on the app.
MS_TENANT_ID=e37d603e-a9ef-4804-bda4-f22f73c66c0c
MS_CLIENT_ID=b16c4d77-3582-4951-ab0c-e0f326c5fb94
MS_CLIENT_SECRET=paste-the-azure-client-secret-VALUE-here   # rotate when it expires
MS_REDIRECT_URI=https://analytics.yourcompany.com/api/auth/microsoft/callback

# ---- Power BI (REQUIRED) -----------------------------------------------------
# The app CANNOT connect to Power BI without these. A fresh install from git does
# NOT include them (server/.env is gitignored and never shared publicly).
# Get these 5 values from the dev/data team and paste them here:
WORKSPACE_ID=c7e619c9-f39c-4491-9c87-2e110bca9330
DATASET_ID=ee931e81-2117-41ee-b1b0-dfca1bb834e2
TENANT_ID=e37d603e-a9ef-4804-bda4-f22f73c66c0c
CLIENT_ID=b16c4d77-3582-4951-ab0c-e0f326c5fb94
CLIENT_SECRET=get-the-powerbi-client-secret-VALUE-from-dev-team

# ---- Prewarm (optional tuning) ----------------------------------------------
# PREWARM_HOUR=6            # local (Kuwait) hour to warm caches before business
# PREWARM_MAX_SCOPES=6      # cap distinct user-scopes warmed on boot
